{
  "name": "accounted-for",
  "version": "1.0.0",
  "private": true,
  "description": "Accounted For (EOP Numbers) native shell",
  "scripts": {
    "bundle": "node tools/bundle.mjs",
    "test": "node tools/bundle.mjs --check && node tools/build-hub.mjs --check && node --test tests/*.test.mjs",
    "build:web": "npm run bundle && node native/build-web.js",
    "sync:ios": "npm run build:web && npx cap sync ios",
    "sync:android": "npm run build:web && npx cap sync android"
  },
  "dependencies": {
    "@capacitor-community/contacts": "^8.0.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "jsdom": "^26.1.0"
  }
}
